{
  "name": "better-dsh-pet",
  "version": "0.3.1",
  "description": "A desktop-native pet bubble driven by DeepSeek Harness session events: transparent always-on-top Electron window, status-aware animations, voice chat/wake, real DSH task execution, emotion, festival, balance, pomodoro, roast, and DSH settings card.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "floating-widget",
    "voice",
    "wake-word",
    "task-execution",
    "emotion",
    "festival",
    "web-ui",
    "cordis",
    "react"
  ],
  "homepage": "https://github.com/ysppwn721/better-dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysppwn721/better-dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/ysppwn721/better-dsh-pet/issues"
  },
  "_comment": [
    "=============== better-dsh-pet 包清单说明 ===============",
    "type: module —— 本包是 ESM",
    "main: lib/index.js —— 宿主半侧入口（Cordis 插件：name/inject/apply）",
    "exports['./client'] —— 浏览器半侧入口，DSH 模块系统按它提供 /plugins/better-dsh-pet/client.js",
    "dsh.bundle.patch —— 声明本包是 bundle，patch 文件是 cordis.patch.yml（安装后自动进层栈）",
    "dsh.client —— 声明浏览器半侧的注入依赖和平台（web）",
    "files —— npm publish 只发这些目录/文件（assets/thumb 播放资源；节日 GIF 仅按需纳入个别文件）",
    "scripts.encode:thumbs —— 转码管线（step03 母版 → assets/thumb 360×360）",
    "scripts.prepack —— 发布前自动健康检查",
    "peerDependencies —— 运行时由宿主（DSH）提供的模块，本包不打包它们",
    "================================================"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime/electron-helper",
    "assets/thumb",
    "assets/preview/zhongqiu-shangyue-chi-yuebing.gif",
    "assets/alarm.mp3",
    "assets/tray-icon.png",
    "cordis.patch.yml",
    "scripts/ensure-electron.mjs",
    "scripts/download-sensevoice.mjs"
  ],
  "scripts": {
    "prepack": "node scripts/prepack-check.js",
    "download:sensevoice": "node scripts/download-sensevoice.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "sherpa-onnx-node": "1.13.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0"
  }
}
